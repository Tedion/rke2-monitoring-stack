# Prometheus Operator Helm Values - Production Configuration with SMTP & Slack
prometheusOperator:
  enabled: true
  resources:
    limits:
      cpu: 1000m
      memory: 1Gi
    requests:
      cpu: 200m
      memory: 256Mi
  admissionWebhooks:
    enabled: false
    failurePolicy: Fail

prometheus:
  enabled: true
  prometheusSpec:
    retention: 60d
    retentionSize: 50GB
    evaluationInterval: 30s
    scrapeInterval: 30s
    scrapeTimeout: 10s
    
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          storageClassName: "nfs-csi"
          resources:
            requests:
              storage: 200Gi
    
    externalLabels:
      cluster: "rke2-production"
      environment: "production"
    
    additionalScrapeConfigs:
      - job_name: 'pushgateway'
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - monitoring
        relabel_configs:
          - source_labels: [__meta_kubernetes_endpoints_name]
            regex: 'prometheus-pushgateway'
            action: keep
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            regex: 'http'
            action: keep
      # External Node Exporters - moved here from root level so Prometheus actually scrapes them
      - job_name: 'external-node-exporters'
        static_configs:
          - targets:
            - '172.16.16.223:9100'  # Rancher
            - '172.16.16.224:9100'  # OpenG2P master
            - '172.16.16.226:9100'  # OpenG2P worker-1
            - '172.16.16.227:9100'  # OpenG2P worker-2
            - '172.16.16.228:9100'  # Nginx
            - '172.16.16.229:9100'  # DB
            - '172.16.16.231:9100'  # MinIO
            - '172.16.16.232:9100'  # Metabase
            labels:
              environment: 'external'
              cluster: 'rke2-production'
        scrape_interval: 30s
        scrape_timeout: 10s
    
    serviceMonitorSelector: {}
    serviceMonitorNamespaceSelector: {}
    podMonitorSelector: {}
    podMonitorNamespaceSelector: {}
    
    # Fixed: Empty ruleSelector picks up ALL PrometheusRule resources
    # This includes both default Helm chart rules (with release: kube-prometheus-stack label)
    # AND custom rules (with prometheus: kube-prometheus,role: alert-rules labels)
    ruleSelector: {}
    ruleNamespaceSelector: {}
    
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      fsGroup: 2000
    
    resources:
      limits:
        cpu: 4000m
        memory: 8Gi
      requests:
        cpu: 1000m
        memory: 4Gi
    
    podDisruptionBudget:
      enabled: false
      minAvailable: 1
    
    replicas: 1

alertmanager:
  enabled: true
  
  
  
  # Alertmanager configuration
  config:
    global:
      resolve_timeout: 5m
      # SMTP configuration - reading password from secret file
      smtp_smarthost: 'smtp.gmail.com:587'
      smtp_from: 'tedionabera@gmail.com'
      smtp_auth_username: 'tedionabera@gmail.com'
      smtp_auth_password_file: '/etc/alertmanager/secrets/alertmanager-smtp/smtp_password'
      smtp_require_tls: true
    
    # Inhibit rules - prevent alert storms
    inhibit_rules:
      # If critical alert fires, suppress warning alerts for same alertname
      - source_match:
          severity: 'critical'
        target_match:
          severity: 'warning'
        equal: ['alertname', 'instance', 'cluster']
      # If high alert fires, suppress low alerts
      - source_match:
          severity: 'high'
        target_match:
          severity: 'low'
        equal: ['alertname', 'instance']
    
    # Route configuration - DevOps best practices
    route:
      receiver: 'default'
      group_by: ['alertname', 'cluster', 'severity', 'component']
      group_wait: 10s
      group_interval: 5m
      repeat_interval: 12h
      
      routes:
      # CRITICAL: Immediate notification via BOTH Email AND Slack
      - match:
          severity: critical
        receiver: 'critical-alerts'
        group_wait: 10s
        group_interval: 5m
        repeat_interval: 1h
        continue: false
        
      # HIGH: Notify via BOTH Email AND Slack (less frequent)
      - match:
          severity: high
        receiver: 'high-alerts'
        group_wait: 30s
        group_interval: 10m
        repeat_interval: 6h
        continue: false
        
      # WARNING: Slack only (no email spam)
      - match:
          severity: warning
        receiver: 'warning-alerts'
        group_wait: 1m
        group_interval: 15m
        repeat_interval: 12h
        continue: false
        
      # LOW/INFO: Slack only, less frequent
      - match:
          severity: low
        receiver: 'low-alerts'
        group_wait: 5m
        group_interval: 30m
        repeat_interval: 24h
        continue: false
    
    # Receivers configuration
    receivers:
    # Default receiver - Slack only (no email spam)
    # Only critical and high alerts will send emails via their specific receivers
    - name: 'default'
      slack_configs:
      - api_url_file: '/etc/alertmanager/secrets/alertmanager-slack/webhook_url'
        channel: '#alerts'
        title: 'Alert: {{ .GroupLabels.alertname }}'
        text: '{{ range .Alerts }}{{ .Annotations.description }}{{ end }}'
        send_resolved: true
    
    # CRITICAL ALERTS: BOTH Email AND Slack (DevOps standard)
    - name: 'critical-alerts'
      email_configs:
      - to: 'tedionabera@gmail.com'
        send_resolved: true
        headers:
          Subject: '[🚨 CRITICAL] {{ .GroupLabels.alertname }} - Action Required'
        html: |
          <h2>🚨 CRITICAL ALERT</h2>
          <p><strong>Alert:</strong> {{ .GroupLabels.alertname }}</p>
          <p><strong>Severity:</strong> {{ .GroupLabels.severity }}</p>
          <p><strong>Component:</strong> {{ .GroupLabels.component }}</p>
          <p><strong>Cluster:</strong> {{ .GroupLabels.cluster }}</p>
          <hr>
          <p><strong>Description:</strong></p>
          <p>{{ range .Alerts }}{{ .Annotations.description }}{{ end }}</p>
          <p><strong>Summary:</strong></p>
          <p>{{ range .Alerts }}{{ .Annotations.summary }}{{ end }}</p>
          <hr>
          <p><small>Alert fired at: {{ range .Alerts }}{{ .StartsAt }}{{ end }}</small></p>
      slack_configs:
      - api_url_file: '/etc/alertmanager/secrets/alertmanager-slack/webhook_url'
        channel: '#alerts'
        title: '🚨 CRITICAL: {{ .GroupLabels.alertname }}'
        text: |
          *🚨 CRITICAL ALERT - IMMEDIATE ACTION REQUIRED 🚨*
          
          *Alert Name:* {{ .GroupLabels.alertname }}
          *Severity:* {{ .GroupLabels.severity }}
          *Component:* {{ .GroupLabels.component }}
          *Cluster:* {{ .GroupLabels.cluster }}
          
          *Description:*
          {{ range .Alerts }}{{ .Annotations.description }}{{ end }}
          
          *Summary:*
          {{ range .Alerts }}{{ .Annotations.summary }}{{ end }}
          
          *Fired At:* {{ range .Alerts }}{{ .StartsAt }}{{ end }}
          *Status:* {{ .Status }}
        send_resolved: true
        color: 'danger'
        footer: 'Prometheus Alertmanager'
    
    # HIGH ALERTS: BOTH Email AND Slack
    - name: 'high-alerts'
      email_configs:
      - to: 'tedionabera@gmail.com'
        send_resolved: true
        headers:
          Subject: '[⚠️ HIGH] {{ .GroupLabels.alertname }}'
        html: |
          <h2>⚠️ HIGH PRIORITY ALERT</h2>
          <p><strong>Alert:</strong> {{ .GroupLabels.alertname }}</p>
          <p><strong>Severity:</strong> {{ .GroupLabels.severity }}</p>
          <p><strong>Component:</strong> {{ .GroupLabels.component }}</p>
          <p><strong>Description:</strong> {{ range .Alerts }}{{ .Annotations.description }}{{ end }}</p>
      slack_configs:
      - api_url_file: '/etc/alertmanager/secrets/alertmanager-slack/webhook_url'
        channel: '#alerts'
        title: '⚠️ HIGH: {{ .GroupLabels.alertname }}'
        text: |
          *⚠️ HIGH PRIORITY ALERT*
          
          *Alert Name:* {{ .GroupLabels.alertname }}
          *Severity:* {{ .GroupLabels.severity }}
          *Component:* {{ .GroupLabels.component }}
          
          *Description:*
          {{ range .Alerts }}{{ .Annotations.description }}{{ end }}
          
          *Summary:*
          {{ range .Alerts }}{{ .Annotations.summary }}{{ end }}
        send_resolved: true
        color: 'warning'
        footer: 'Prometheus Alertmanager'
    
    # WARNING ALERTS: Slack only (no email spam)
    - name: 'warning-alerts'
      slack_configs:
      - api_url_file: '/etc/alertmanager/secrets/alertmanager-slack/webhook_url'
        channel: '#alerts'
        title: 'ℹ️ WARNING: {{ .GroupLabels.alertname }}'
        text: |
          *ℹ️ WARNING ALERT*
          
          *Alert Name:* {{ .GroupLabels.alertname }}
          *Severity:* {{ .GroupLabels.severity }}
          *Component:* {{ .GroupLabels.component }}
          
          *Description:*
          {{ range .Alerts }}{{ .Annotations.description }}{{ end }}
        send_resolved: true
        color: 'good'
        footer: 'Prometheus Alertmanager'
    
    # LOW/INFO ALERTS: Slack only
    - name: 'low-alerts'
      slack_configs:
      - api_url_file: '/etc/alertmanager/secrets/alertmanager-slack/webhook_url'
        channel: '#alerts'
        title: 'ℹ️ INFO: {{ .GroupLabels.alertname }}'
        text: |
          *ℹ️ INFO ALERT*
          
          *Alert Name:* {{ .GroupLabels.alertname }}
          *Severity:* {{ .GroupLabels.severity }}
          
          *Description:*
          {{ range .Alerts }}{{ .Annotations.description }}{{ end }}
        send_resolved: false
        color: '#439FE0'
        footer: 'Prometheus Alertmanager'
  
  # Alertmanager resources and HA
  alertmanagerSpec:
    # The 'secrets' field automatically mounts secrets at /etc/alertmanager/secrets/<name>/
    # which matches the paths referenced in the config above (smtp_auth_password_file and api_url_file)
    secrets:
      - alertmanager-smtp
      - alertmanager-slack
    # Removed extraSecretMounts - redundant and was mounting to wrong paths
    # The 'secrets' field above already handles correct mounting

    replicas: 2
    retention: 120h
    storage:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
          storageClassName: "nfs-csi"
          resources:
            requests:
              storage: 10Gi
    resources:
      limits:
        cpu: 500m
        memory: 512Mi
      requests:
        cpu: 100m
        memory: 128Mi
    podDisruptionBudget:
      enabled: false
      minAvailable: 1
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      fsGroup: 2000

grafana:
  enabled: true
  defaultDatasourceEnabled: false
  adminUser: admin
  adminPassword: "CHANGE_ME_IN_PRODUCTION"
  
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s:%(http_port)s/"
      serve_from_sub_path: false
    security:
      admin_user: admin
    auth:
      disable_login_form: false
      disable_signout_menu: false
  
  persistence:
    enabled: false
    type: pvc
    storageClassName: "nfs-csi"
    accessModes:
      - ReadWriteOnce
    size: 20Gi
  
  resources:
    limits:
      cpu: 1000m
      memory: 1Gi
    requests:
      cpu: 200m
      memory: 256Mi
  
  service:
    type: ClusterIP
    port: 80
  
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
      - name: 'default'
        orgId: 1
        folder: ''
        type: file
        disableDeletion: false
        editable: true
        options:
          path: /var/lib/grafana/dashboards/default
      - name: 'kubernetes'
        orgId: 1
        folder: 'Kubernetes'
        type: file
        disableDeletion: false
        editable: true
        options:
          path: /var/lib/grafana/dashboards/kubernetes
  
  dashboards:
    default:
      kubernetes-overview:
        gnetId: 7249
        revision: 1
        datasource: Prometheus
      node-exporter:
        gnetId: 1860
        revision: 27
        datasource: Prometheus
      prometheus-stats:
        gnetId: 2
        revision: 1
        datasource: Prometheus
    kubernetes:
      kubernetes-cluster-monitoring:
        gnetId: 7249
        revision: 1
        datasource: Prometheus
  
  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
      - name: Prometheus
        type: prometheus
        uid: prometheus
        access: proxy
        url: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
        isDefault: true
        editable: true
        jsonData:
          httpMethod: POST
          timeInterval: 30s
      - name: Alertmanager
        type: alertmanager
        uid: alertmanager
        access: proxy
        url: http://kube-prometheus-stack-alertmanager.monitoring.svc.cluster.local:9093
        editable: true
        jsonData:
          handleGrafanaManagedAlerts: false
          implementation: prometheus
      - name: Loki
        type: loki
        access: proxy
        url: http://loki-stack.monitoring.svc.cluster.local:3100
        editable: true

nodeExporter:
  enabled: true
  resources:
    limits:
      cpu: 200m
      memory: 180Mi
    requests:
      cpu: 100m
      memory: 180Mi

kubeStateMetrics:
  enabled: true
  resources:
    limits:
      cpu: 200m
      memory: 256Mi
    requests:
      cpu: 100m
      memory: 128Mi

prometheus-node-exporter:
  enabled: true

